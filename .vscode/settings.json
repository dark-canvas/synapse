{
  "rust-analyzer.rustup.toolchain": "nightly-2026-07-11",
  "rust-analyzer.rustup.toolchain": "nightly-2026-07-11",
  "rust-analyzer.cargo.extraEnv": {
    "CARGO_TARGET_DIR": "target/kernel",
    "RUSTFLAGS": "-C link-arg=-Tmemory_layout.ld"
