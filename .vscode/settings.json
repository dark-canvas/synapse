  "rust-analyzer.check.command": "check",
  "rust-analyzer.check.extraArgs": [
    "-Z",
    "build-std-features=compiler-builtins-mem",
    "-Z",
    "build-std=core,compiler_builtins"
  ],
  "makefile.configureOnOpen": false,
  "git.addAICoAuthor": "off"
}